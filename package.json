{
  "name": "proccity",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,magenta \"vite\" \"tsx watch ./src/server.ts\"",
    "dev:restart": "systemctl --user restart proccity",
    "build": "vite build && tsc --noEmit -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kninnug/constrainautor": "^4.1.0",
    "clipper2-ts": "^2.0.1-19",
    "cors": "^2.8.6",
    "d3-delaunay": "^6.0.6",
    "delaunator": "^5.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simplex-noise": "^4.0.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/d3-delaunay": "^6.0.4",
    "@types/delaunator": "^5.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
